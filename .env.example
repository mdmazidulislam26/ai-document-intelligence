# Environment (set ENVIRONMENT=production in production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database & Redis (Override with strong credentials in production; keep .env out of Git)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=doc_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_postgres_password@localhost:5432/doc_intelligence
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:change_me_strong_postgres_password@localhost:5432/doc_intelligence
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

# Migration Safety (set false in production and run 'alembic upgrade head' explicitly during deploy)
AUTO_RUN_MIGRATIONS=true

# AI Provider (Groq Free Tier)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Security (MUST override in production)
AUTH_SECRET_KEY=replace-with-strong-random-32byte-secret
API_KEYS_JSON={"dev-local-api-key-change-me":{"owner_id":"default","role":"user"}}
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Limits & Rate Limiting
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=20
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_WRITE_PER_MIN=30
