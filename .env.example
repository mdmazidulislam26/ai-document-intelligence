# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/doc_intelligence

# Redis Configuration (Broker and Result Backend)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Free AI API Configuration
# Option 1: Groq Cloud API (100% free tier at console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_free_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Storage
UPLOAD_DIR=/tmp/doc_intelligence/uploads
MAX_UPLOAD_SIZE_MB=50

# Local Free Embedding Model (Runs locally inside Codespaces on CPU)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384